{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/slides", "destination": "/slides/index.html", "permanent": false },
    { "source": "/slides/", "destination": "/slides/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
