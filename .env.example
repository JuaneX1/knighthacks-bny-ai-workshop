# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Optional: max AI calls per minute across the whole game (each team gets half)
LLM_MAX_CALLS_PER_MINUTE=10

# Session signing secret (any long random string)
SESSION_SECRET=

# Admin bearer token (any long random string)
ADMIN_TOKEN=
