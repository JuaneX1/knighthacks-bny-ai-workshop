# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Optional: max AI calls per 15-second window across the whole game (each playing team gets an
# equal share). Use 20 for a 4-team tournament so each team keeps the same speed as a duel.
LLM_MAX_CALLS_PER_MINUTE=10

# Session signing secret (any long random string)
SESSION_SECRET=

# Admin bearer token (any long random string)
ADMIN_TOKEN=
